    <build>
        <plugins>
            <!-- run-example.sh invokes this plugin to launch an example. -->
            <plugin>
                <groupId>kr.motd.maven</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <commandlineArgs>
                        ${argLine.common}
                        -classpath %classpath
                        ${argLine.leak}
                        ${argLine.coverage}
                        ${argLine.example}
                        ${exampleClass}
                    </commandlineArgs>
                </configuration>
            </plugin>
        </plugins>
